pipeline {
    agent any

    environment {
        POSTGRES_SECRET = credentials('postgres-credentials')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'echo "Repository checked out successfully - User: ${POSTGRES_SECRET_USR}"'
                sh 'ls -la'
            }
        }

        stage('Navigate to Project Directory') {
            steps {
                sh '''
                    echo "Current directory:"
                    pwd
                    echo "Listing contents:"
                    ls -la
                    echo "Looking for PyTest DQ Framework directory..."
                    ls -la "PyTest DQ Framework/" || echo "Directory not found"
                '''
            }
        }

        stage('Setup Python Environment') {
            steps {
                sh '''
                    echo "Setting up Python virtual environment in PyTest DQ Framework directory..."
                    cd "PyTest DQ Framework"
                    python3 -m venv venv
                    . venv/bin/activate
                    pip3 install --upgrade pip
                    pip3 install -r requirements.txt
                    echo "Dependencies installed successfully"
                '''
            }
        }

        stage('Run Data Quality Tests') {
            steps {
                sh '''
                    echo "Running Data Quality Tests with user: ${POSTGRES_SECRET_USR}"
                    cd "PyTest DQ Framework"
                    . venv/bin/activate

                    # Run tests
                    python -m pytest tests/dq\\ checks/parquet_files/test_facility_name_min_time_spent_per_visit_date.py \
                        -m "parquet_data" \
                        --db_host="postgres" \
                        --db_port="5432" \
                        --db_name="mydatabase" \
                        --db_user=$POSTGRES_SECRET_USR \
                        --db_password=$POSTGRES_SECRET_PSW \
                        --html=html_report/report.html \
                        --self-contained-html \
                        --verbose

                    echo "Tests completed successfully"
                '''
            }
        }

        stage('Archive Test Results') {
            steps {
                sh '''
                    echo "Archiving test results..."
                    cd "PyTest DQ Framework"
                    mkdir -p html_report
                    echo "Report generated at: html_report/report.html"
                '''

                archiveArtifacts artifacts: 'PyTest DQ Framework/html_report/**', allowEmptyArchive: true
                publishHTML(target: [
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'PyTest DQ Framework/html_report',
                    reportFiles: 'report.html',
                    reportName: 'PyTest DQ Framework Report'
                ])
            }
        }
    }

    post {
        always {
            sh 'echo "Pipeline execution completed - Check HTML report for details"'
        }
        success {
            sh 'echo "SUCCESS: All Data Quality tests passed!"'
        }
        failure {
            sh 'echo "FAILURE: Tests failed or authentication issue"'
        }
    }
}